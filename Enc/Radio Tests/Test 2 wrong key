#Test 2: Wrong Key Attacker
#Sends encrypted commands with INCORRECT key
#Expected result: Vehicle rejects all commands (decryption produces invalid data)
from microbit import *
import radio

radio.config(group=5)
radio.on()

KEY = "wrongkey1"
counter = 0
count = 0

def encrypt(msg, key):
    out = ""
    for i in range(len(msg)):
        val = ord(msg[i]) ^ ord(key[i % len(key)])
        out += "{:02x}".format(val)
    return out

def send_cmd(cmd):
    global counter
    counter += 1
    msg = str(counter) + ":" + cmd
    radio.send(encrypt(msg, KEY))

while True:
    if button_a.was_pressed():
        send_cmd("forwards")
        count += 1
        display.show(str(count % 10))
        sleep(200)
    elif button_b.was_pressed():
        send_cmd("stop")
        count += 1
        display.show(str(count % 10))
        sleep(200)
    sleep(50)
