from microbit import pin8, display, sleep, button_a, button_b

display.off()
pin8.set_analog_period(20)

CLAW_OPEN = 140
CLAW_CLOSED = 5

def set_angle(deg):
    pulse = 544 + int((2400 - 544) * deg / 180)
    duty = int(pulse / 20000 * 1023)
    pin8.write_analog(duty)

# Start closed
set_angle(CLAW_CLOSED)

while True:
    if button_b.was_pressed():
        set_angle(CLAW_OPEN)

    if button_a.was_pressed():
        set_angle(CLAW_CLOSED)

    sleep(50)
